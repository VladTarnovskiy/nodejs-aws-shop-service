{
  "app": "npx ts-node --prefer-ts-exts bin/product-service.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "cdk.out"
    ]
  },
  "context": {
    "createProductTopicEmail": "your-email@example.com",
    "createProductTopicEmailHighPrice": "your-high-price@example.com",
    "createProductTopicEmailLowStock": "your-low-stock@example.com",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"]
  }
}
